{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node 'C:\\adze-cad\\.codex\\hooks\\block-protected-files.js'",
            "statusMessage": "Checking file protections..."
          },
          {
            "type": "command",
            "command": "node 'C:\\adze-cad\\.codex\\hooks\\gitnexus-impact-check.js'",
            "timeout": 15,
            "statusMessage": "Running impact analysis..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node 'C:\\adze-cad\\.codex\\hooks\\block-dangerous-commands.js'",
            "statusMessage": "Checking command safety..."
          }
        ]
      },
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}' || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node 'C:\\adze-cad\\.codex\\hooks\\typecheck-on-edit.js'",
            "timeout": 30,
            "statusMessage": "Type-checking..."
          },
          {
            "type": "command",
            "command": "node 'C:\\adze-cad\\.codex\\hooks\\lint-on-edit.js'",
            "timeout": 15,
            "statusMessage": "Linting..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node 'C:\\adze-cad\\.codex\\hooks\\gitnexus-post-commit.js'",
            "statusMessage": "Updating GitNexus index..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node 'C:\\adze-cad\\.codex\\hooks\\session-context.js'",
            "statusMessage": "Loading project context..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node 'C:\\adze-cad\\.codex\\hooks\\stop-closeout-check.js'",
            "statusMessage": "Checking documentation freshness..."
          },
          {
            "type": "command",
            "command": "node 'C:\\adze-cad\\.codex\\hooks\\session-export-on-close.js'",
            "timeout": 20,
            "statusMessage": "Auto-exporting session note..."
          },
          {
            "type": "command",
            "command": "node 'C:\\adze-cad\\.codex\\hooks\\completion-check.js'",
            "statusMessage": "Checking feature completion..."
          }
        ]
      }
    ]
  }
}
