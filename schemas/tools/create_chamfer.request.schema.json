{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adze.dev/schemas/tools/create_chamfer.request.schema.json",
  "title": "create_chamfer request",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool_name", "action_class", "parameters"],
  "properties": {
    "tool_name": { "const": "create_chamfer" },
    "action_class": { "const": "red" },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_names", "distance_mm"],
      "properties": {
        "entity_names": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Edges or faces to chamfer."
        },
        "distance_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Chamfer distance in mm."
        },
        "angle_degrees": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 90,
          "default": 45,
          "description": "Chamfer angle in degrees."
        },
        "feature_name": {
          "type": ["string", "null"],
          "default": null,
          "description": "Optional name for the new feature."
        }
      }
    }
  }
}
