{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adze.dev/schemas/tools/analyze_mesh_file.request.schema.json",
  "title": "analyze_mesh_file request",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool_name", "action_class", "parameters"],
  "properties": {
    "tool_name": { "const": "analyze_mesh_file" },
    "action_class": { "const": "green" },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_path"],
      "properties": {
        "file_path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path to a mesh file. Currently supports .stl (binary or ASCII)."
        },
        "max_advisories": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "description": "Maximum advisory strings to include in the result."
        }
      }
    }
  }
}
