{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adze.dev/schemas/tools/add_sketch_circle.request.schema.json",
  "title": "add_sketch_circle request",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool_name", "action_class", "parameters"],
  "properties": {
    "tool_name": { "const": "add_sketch_circle" },
    "action_class": { "const": "yellow" },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center_x_mm", "center_y_mm", "radius_mm"],
      "properties": {
        "center_x_mm": { "type": "number" },
        "center_y_mm": { "type": "number" },
        "radius_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sketch_name": {
          "type": ["string", "null"],
          "default": null
        }
      }
    }
  }
}
